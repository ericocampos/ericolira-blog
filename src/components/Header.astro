---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
import ThemeToggle from './ThemeToggle.astro';
---

<header>
  <nav>
    <h2 class="site-title"><a href="/">{SITE_TITLE}</a></h2>
    <div class="links">
      <HeaderLink href="/">início</HeaderLink>
      <HeaderLink href="/about">sobre</HeaderLink>
      <a href="/rss.xml">rss</a>
      <a href="https://github.com/ericocampos" target="_blank" rel="noopener" aria-label="GitHub">github</a>
      <ThemeToggle />
    </div>
  </nav>
</header>

<style>
  header {
    border-bottom: 1px solid var(--border-faint);
    background: var(--bg);
  }
  nav {
    width: var(--content-width);
    max-width: calc(100% - 2 * var(--content-padding));
    margin: 0 auto;
    padding: 1rem var(--content-padding);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .site-title {
    margin: 0;
    font-size: 0.95rem;
    font-weight: 700;
  }
  .site-title a {
    color: var(--text);
    text-decoration: none;
  }
  .site-title a:hover {
    color: var(--accent);
    background: transparent;
  }
  .links {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    font-size: 0.9rem;
  }
  .links a {
    color: var(--text-muted);
    text-decoration: none;
  }
  .links a:hover,
  .links a.active {
    color: var(--accent);
    background: transparent;
  }
  @media (max-width: 560px) {
    nav { flex-wrap: wrap; gap: 0.5rem; }
    .links { gap: 0.85rem; font-size: 0.85rem; }
  }
</style>
